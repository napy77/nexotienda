# API de NexoPOS. Vacío = la tienda corre con los fixtures de diseño.
# NEXOPOS_API_URL="https://pos.linware.com.ar/api"

# Tres claves separadas por CAPACIDAD, no por comercio. Solo del lado del servidor.
#   catalogo — lo que la tienda le muestra a cualquiera
#   pedidos  — escribe, pero no llega a ninguna cuenta
#   cuentas  — la sensible; además pide la sesión del token de ClubPay
# NEXOPOS_KEY_CATALOGO=""
# NEXOPOS_KEY_PEDIDOS=""
# NEXOPOS_KEY_CUENTAS="

# Dominio raíz. En desarrollo se usa localhost:3000 con subdominios
# (ej. http://supersol.localhost:3000).
NEXT_PUBLIC_ROOT_DOMAIN="nexotienda.app"
